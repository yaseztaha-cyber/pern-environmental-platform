# VITE_API_URL intentionally unset: app uses same-origin /api (Vite proxy) so it
# works from any host/IP (local, Tailnet, or public tunnel).
VITE_LOGTO_ENDPOINT=https://your-tenant.logto.app
VITE_LOGTO_APP_ID=your-logto-app-id
# Live-mode MQTT broker over WebSocket (browser connects directly).
# Leave unset to use the default public broker.
VITE_MQTT_BROKER_WS=wss://broker.emqx.io:8084/mqtt
