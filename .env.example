# PERN Environment Configuration
# Copy this to .env and fill in your values

# Frontend (Vite)
VITE_LOGTO_ENDPOINT=http://localhost:3001
VITE_LOGTO_APP_ID=your-app-id-here
VITE_LOGTO_REDIRECT_URI=http://localhost/#/auth/callback

# Backend
PORT=3000
DATABASE_URL=postgresql://pern:pern_secret@localhost:5432/pern_db
JWT_SECRET=change-this-to-a-random-string-in-production
MQTT_BROKER=mqtt://localhost:1883
NTFY_TOPIC=pern-platform-alerts-2026
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Logto Auth
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002

# Docker (use service names instead of localhost)
# DATABASE_URL=postgresql://pern:pern_secret@postgres:5432/pern_db
# MQTT_BROKER=mqtt://mqtt-broker:1883
# LOGTO_ENDPOINT=http://logto:3001
