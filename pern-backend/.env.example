# ============================================================
# PERN Backend Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- OpenRouter AI API ---
# Get a free key at https://openrouter.ai/keys (or leave blank for AI features to be disabled)
OPENROUTER_API_KEY=

# --- PERN forecast engine (pern-ai microservice) ---
# Serves the calibrated 1/7/30-day temperature forecast (/v1/forecast) and the
# published tolerance-accuracy tables (/v1/benchmark). Optional: when the
# microservice is unreachable the API degrades (503 for /ai-tools/forecast).
PERN_AI_URL=http://localhost:8000
PERN_AI_TIMEOUT_MS=4000


# --- Database (matches docker-compose.yml credentials) ---
DATABASE_URL=postgresql://pern:pern_secret@localhost:5432/pern_db

# --- JWT / Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- MQTT Broker ---
MQTT_BROKER=mqtt://localhost:1883

# --- Server ---
PORT=3000

# --- Environment ---
NODE_ENV=development

# --- Push Notifications ---
NTFY_TOPIC=pern-platform-alerts-2026

# --- Auth enforcement ---
# IMPORTANT: Set to 'true' in production
ENFORCE_AUTH=false

# --- Logto OIDC (optional for local dev) ---
LOGTO_ENDPOINT=https://your-tenant.logto.app
LOGTO_APP_ID=your-logto-app-id

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Email (SMTP — optional) ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@localhost

# --- SMS (Twilio — optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Webhook (optional) ---
WEBHOOK_URL=

# --- Slack (optional) ---
SLACK_WEBHOOK_URL=
