# ============================================================
# PERN Backend Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- OpenRouter AI API ---
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# --- Database ---
DATABASE_URL=postgresql://pern:your_secure_password@localhost:5432/pern_db

# --- JWT / Auth ---
JWT_SECRET=generate-a-random-256-bit-secret

# --- MQTT Broker ---
MQTT_BROKER=mqtt://localhost:1883

# --- Server ---
PORT=3000

# --- Environment ---
# Set to 'production' in deployed environments
NODE_ENV=development

# --- Push Notifications ---
NTFY_TOPIC=pern-platform-alerts-2026

# --- Auth enforcement ---
# Set to 'true' in production when Logto is configured.
# In local dev without Logto, leave unset or 'false' for demo mode.
ENFORCE_AUTH=false

# --- Logto OIDC ---
LOGTO_ENDPOINT=https://your-tenant.logto.app
LOGTO_APP_ID=your-logto-app-id

# --- CORS (comma-separated list of allowed origins) ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Email (SMTP) ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=alerts@yourdomain.com

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Webhook ---
WEBHOOK_URL=

# --- Slack ---
SLACK_WEBHOOK_URL=
